# ============================================================
# CONFIGURAÇÕES DO ORACLE
# ============================================================
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=XE

# Schemas Oracle
ORACLE_PETSHOP_USER=C##PETSHOP
ORACLE_PETSHOP_PASSWORD=your_password_here

ORACLE_FEIRA_USER=C##FEIRA
ORACLE_FEIRA_PASSWORD=your_password_here

ORACLE_SA_USER=C##SA
ORACLE_SA_PASSWORD=your_password_here

# ============================================================
# CONFIGURAÇÕES DO POSTGRESQL - FILIAL ITABUNA
# ============================================================
PG_ITABUNA_HOST=localhost
PG_ITABUNA_PORT=5435
PG_ITABUNA_DB=petshop_itabuna
PG_ITABUNA_USER=postgres
PG_ITABUNA_PASSWORD=your_password_here

# ============================================================
# CONFIGURAÇÕES DO POSTGRESQL - DATA WAREHOUSE (petshop_dw)
# ============================================================
PG_DW_HOST=localhost
PG_DW_PORT=5434
PG_DW_DB=petshop_dw
PG_DW_USER=postgres
PG_DW_PASSWORD=your_password_here
